# Required: external local Swagger 2.0 API file and HTTP(S) origin.
OSEON_API_FILE=
OSEON_BASE_URL=

# Complete installation-specific Authorization header, OR both Basic values.
OSEON_AUTHORIZATION=
OSEON_USERNAME=
OSEON_PASSWORD=

# Optional booking headers, only sent where the operation declares them.
OSEON_USER_HEADER=
OSEON_TERMINAL_HEADER=
OSEON_API_VERSION=2.0

# Mutations are disabled unless explicitly enabled at startup.
OSEON_ALLOW_WRITES=false
OSEON_TIMEOUT=30
